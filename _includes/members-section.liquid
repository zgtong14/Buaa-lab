<!--
  Local re-implementation of al_folio_core's _layouts/profiles.liquid card
  loop, extracted into an include so it can be dropped into both the
  standalone /members/ page and the single-scroll homepage. Reads from
  _data/members.yml (this repo's own data file) instead of page front
  matter, and uses `include` instead of `include_relative` since the member
  bio fragments live in _includes/members/, not next to the caller.
-->
{% for profile in site.data.members %}
  <hr>
  <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}" markdown="0">
    {% if profile.image %}
      {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
      {% if profile.image_circular %}
        {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
      {% else %}
        {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
      {% endif %}
      {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
      {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image %}
    {% endif %}
    {% if profile.more_info %}
      <div class="more-info">{{ profile.more_info }}</div>
    {% endif %}
  </div>

  <div class="clearfix">
    {% if profile.content %}
      {% capture profile_content %}{% include {{ profile.content }} %}{% endcapture %}
      {{ profile_content | markdownify }}
    {% endif %}
  </div>
{% endfor %}
