@comment{
  Add your lab's publications below in BibTeX format.
  Example fields supported by jekyll-scholar / al_citations:
    abbr        - short venue tag shown as a badge (e.g. {ISSCC})
    bibtex_show = {true}  - shows a "Bib" button with the raw BibTeX entry
    selected    = {true}  - shows the entry on the home page "selected publications" list
    pdf         - filename in assets/pdf/ for a "PDF" download link
    preview     - filename in assets/img/publication_preview/ for a thumbnail
    website / code / video - extra link buttons

  Example:

  @inproceedings{tong2024example,
    abbr      = {ISSCC},
    bibtex_show = {true},
    selected  = {true},
    title     = {Example Paper Title Goes Here},
    author    = {Tong, Zhiguo and Han, Bin},
    booktitle = {IEEE International Solid-State Circuits Conference (ISSCC)},
    year      = {2024}
  }
}
